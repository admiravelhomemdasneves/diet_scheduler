<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only override of android/app/src/main/res/xml/network_security_config.xml.
  Android's domain-config only accepts literal hostnames/IPs, not CIDR ranges, so each
  address the backend might be reached at during dev needs its own <domain> entry:
    - 10.0.2.2   the Android emulator's alias for the host machine's loopback
    - localhost  iOS simulator / some emulator configurations
    - 192.168.1.66  this dev machine's current LAN IP (see mobile/dart_define/lan.json);
      update this if the LAN IP changes (DHCP renewal, different network).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.1.66</domain>
    </domain-config>
</network-security-config>
