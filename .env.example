# Copy this file to .env (in the same directory, project root) and fill in the blanks.
# .env is gitignored -- never commit it.
#
#   cp .env.example .env        (bash)
#   Copy-Item .env.example .env (PowerShell)

# Which Spring profile to run. "dev" relaxes schema management (ddl-auto: update) and
# logs at DEBUG; leave this as "dev" for local/LAN use. See backend/src/main/resources/.
SPRING_PROFILES_ACTIVE=dev

# --- Postgres ---
# POSTGRES_* are read by the postgres container itself; DIETSCHEDULER_DB_* are read by the
# backend to connect to it. They must describe the same database.
POSTGRES_DB=dietscheduler
POSTGRES_USER=dietscheduler
POSTGRES_PASSWORD=

DIETSCHEDULER_DB_URL=jdbc:postgresql://postgres:5432/dietscheduler
DIETSCHEDULER_DB_USER=dietscheduler
DIETSCHEDULER_DB_PASSWORD=

# --- JWT signing secret ---
# Required. Must be at least 32 random characters (HS256 needs >= 256 bits). The backend
# refuses to start without this set to something other than a known placeholder.
# Generate one (Windows PowerShell 5.1 -- RandomNumberGenerator.GetBytes needs .NET 6+, so use
# the older RNGCryptoServiceProvider instead):
#   Add-Type -AssemblyName System.Security
#   $b = New-Object byte[] 48
#   (New-Object Security.Cryptography.RNGCryptoServiceProvider).GetBytes($b)
#   [Convert]::ToBase64String($b)
# or (PowerShell 7+ / pwsh):
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# or (bash):
#   openssl rand -base64 48
DIETSCHEDULER_JWT_SECRET=

# --- Google OAuth ---
# This is a public identifier (an OAuth *client ID*, not a client secret), safe to share --
# the Android client is authorized by package name + signing certificate, not this value.
# The default below is the project's existing web client ID; only change it if you register
# your own OAuth consent screen.
DIETSCHEDULER_GOOGLE_CLIENT_IDS=337611843888-aj9o1a0s9ls2bue3jlqcq9pcd5kqqnua.apps.googleusercontent.com

# --- Misc ---
DIETSCHEDULER_LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API cross-origin. Leave empty unless
# you're building a web/browser client -- the mobile app doesn't need this (it's not a browser).
DIETSCHEDULER_CORS_ORIGINS=
